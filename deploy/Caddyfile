# Round-robin over every pimpbase container Docker's DNS returns, taking a
# server out while its /readyz fails (draining, or its database is gone).
:8080 {
	reverse_proxy {
		dynamic a pimpbase 8080 {
			refresh 5s
		}
		lb_policy round_robin
		lb_retries 2
		health_uri /readyz
		health_interval 5s
		health_timeout 3s
		flush_interval -1
	}
}
